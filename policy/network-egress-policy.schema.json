{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/network-egress-policy-v1.json",
  "title": "NEXUS network egress policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default", "grants"],
  "properties": {
    "version": {"const": 1},
    "default": {"const": "deny"},
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject", "purpose", "host", "port", "methods", "content_types",
          "max_request_bytes", "max_response_bytes", "expires_at"
        ],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "port": {"const": 443},
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["GET", "HEAD", "POST"]}
          },
          "content_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "max_request_bytes": {"type": "integer", "minimum": 0},
          "max_response_bytes": {"type": "integer", "minimum": 1},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
