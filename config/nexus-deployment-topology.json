  "workload_routes": [
    {
      "workload": "desktop_product_runtime",
      "preferred": "laptop-1",
      "fallback": "none_automatic",
      "notes": "preserve verified install until replacement passes exact-head verification"
    },
    {
      "workload": "paper_writer",
      "preferred": "laptop-1",
      "fallback": "explicit_recovery_only",
      "notes": "exactly one writer to shared Paper state"
    },
    {
      "workload": "paper_protective_exit",
      "preferred": "laptop-1",
      "fallback": "explicit_recovery_only",
      "notes": "reduce/close only; never open/reverse/live"
    },
    {
      "workload": "strategy_research",
      "preferred": "NEXUS-RESEARCH-RUNNER",
      "fallback": "laptop-1 research failover watchdog capability",
      "notes": "no duplicate primary research runner"
    },
    {
      "workload": "local_windows_integration",
      "preferred": "NEXUS-LOCAL-RUNNER",
      "fallback": "NEXUS-LOCAL-FAILOVER",
      "notes": "conditional failover only"
    },
    {
      "workload": "bybit_public_network",
      "preferred": "NEXUS-BYBIT-WSL",
      "fallback": "NEXUS-BYBIT-FAILOVER",
      "notes": "public/research data and Paper-safe network boundary"
    },
    {
      "workload": "windows_recovery",
      "preferred": "NEXUS-WINDOWS-DR",
      "fallback": "manual_owner_recovery",
      "notes": "recovery role, not normal workload capacity"
    },
    {
      "workload": "ci_and_independent_verification",
      "preferred": "github-actions-cloud",
      "fallback": "cloud_fallback_workflow",
      "notes": "does not own Paper state"
    }
