  "failover_policy": {
    "normal_state": {
      "laptop-1": [
        "runtime_paper_primary",
        "local_primary",
        "bybit_network_primary",
        "windows_dr_ready"
      ],
      "laptop-2": [
        "research_primary",
        "failover_watchdogs_ready"
      ]
    },
    "activation_rule": "standby runner activates only after verified primary health loss; it must return to standby after stable primary recovery",
    "forbidden": [
      "two concurrent paper writers",
      "two always-on local runners for same role",
      "two always-on bybit network runners for same role",
      "secondary research runner active without explicit capacity reason",
      "failover activation based only on stale UI state"
    ]
  },
  "new_work_gate": [
    "identify_system_map_node",
    "check_existing_capability_before_building_new",
    "identify_upstream_and_downstream_dependencies",
    "select_exact_runner_or_cloud_resource",
    "confirm_authority_boundary_and_demo_only",
    "define_acceptance_test_and_independent_verifier",
    "define_durable_evidence_location",
    "define_deployment_and_rollback",
    "update_topology_if_role_or_connection_changes"
  ]
