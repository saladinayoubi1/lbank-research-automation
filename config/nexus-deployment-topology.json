    },
    {
      "id": "lbank",
      "role": "backup_research_market_data",
      "status": "active_workflow_present",
      "authority": "research_data_only"
    },
    {
      "id": "bitget",
      "role": "requested_backup_research_market_data",
      "status": "must_verify_current_main_before_activation",
      "authority": "research_data_only"
    },
    {
      "id": "tradingview",
      "role": "reference_or_ai_context_only",
      "status": "non_authoritative",
      "authority": "must_not_replace_canonical_exchange_execution"
