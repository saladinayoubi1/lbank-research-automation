{
  "name": "nexus-personal-pro",
  "version": "3.5.0",
  "description": "NEXUS research, backtest and paper-trading desktop workspace",
  "main": "main.js",
  "author": "saladinayoubi1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "34.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.saladinayoubi.nexuspersonal",
    "productName": "NEXUS Personal Pro",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{"from":"app","to":"app","filter":["**/*"]}],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "NEXUS_Personal_Pro_Setup_${version}_${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS Personal Pro",
      "installerLanguages": ["en_US"]
    },
    "portable": {
      "artifactName": "NEXUS_Personal_Pro_Portable_${version}_${arch}.${ext}"
    }
  }
}
