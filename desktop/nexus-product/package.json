{
  "name": "nexus-personal-pro-product",
  "version": "5.1.0",
  "description": "NEXUS Personal Pro final offline-first Mission Control for research, strategy, agents, risk and paper execution",
  "main": "bootstrap-main.js",
  "author": "saladinayoubi1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node stage-package-resources.js && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "34.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.saladinayoubi.nexuspersonal.product",
    "productName": "NEXUS Personal Pro",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["bootstrap-main.js", "main.js", "preload.js", "package.json"],
    "extraResources": [
      {"from":"sidecar/nexus-product-server","to":"nexus-product-server"},
      {"from":"sidecar/source-sha.txt","to":"source-sha.txt"},
      {"from":"sidecar/build-evidence.json","to":"build-evidence.json"},
      {"from":"sidecar/market-data-source-registry.yaml","to":"docs/architecture/market-data-source-registry.yaml"},
      {"from":"sidecar/nexus-agent-manager.json","to":"config/nexus-agent-manager.json"},
      {"from":"sidecar/bootstrap_nexus_runner_from_gui.ps1","to":"scripts/bootstrap_nexus_runner_from_gui.ps1"},
      {"from":"sidecar/install_nexus_owner_autostart_from_gui.ps1","to":"scripts/install_nexus_owner_autostart_from_gui.ps1"},
      {"from":"sidecar/nexus-source.bundle","to":"nexus-source.bundle"}
    ],
    "win": {"target": ["nsis", "portable"]},
    "nsis": {
      "artifactName": "NEXUS_Personal_Pro_Setup_${version}_${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS Personal Pro",
      "installerLanguages": ["en_US"]
    },
    "portable": {"artifactName": "NEXUS_Personal_Pro_Portable_${version}_${arch}.${ext}"}
  }
}
