[Unit]
Description=NEXUS VPS read-only arbiter observer (NO Paper writer authority)
After=network.target systemd-journald.service
ConditionPathExists=/opt/nexus-arbiter/current/nexus_vps_arbiter_observer.py

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/python3 -B /opt/nexus-arbiter/current/nexus_vps_arbiter_observer.py --serve
WorkingDirectory=/opt/nexus-arbiter/current
Restart=on-failure
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=128M
TasksMax=30

[Install]
WantedBy=multi-user.target
